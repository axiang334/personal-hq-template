{
  "roles": [
    {
      "key": "owner",
      "label": "发起端（我的视图）",
      "desc": "所有项目、所有节点、所有交付、所有分佣、所有结算——全量台账，仅自己可见。"
    },
    {
      "key": "client",
      "label": "项目端（客户视图）",
      "desc": "客户只看到自己项目的进度、交付结果与数据表现；看不到分佣规则、认领节点、内部成本。"
    },
    {
      "key": "node",
      "label": "认领端（节点视图）",
      "desc": "节点看到可认领项目、自己认领的项目、自己的交付数据与分佣记录；看不到其他节点分佣与客户全貌。"
    }
  ],
